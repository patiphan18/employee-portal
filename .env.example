# Copy to .env and adjust. docker-compose.yml carries development defaults already.
APP_ENV=development
PORT=8000
DATABASE_URL=postgres://portal:portal@localhost:5432/portal?sslmode=disable
JWT_SECRET=change-me-in-production
JWT_TTL_MINUTES=60
HISTORY_RETENTION_DAYS=7
MAX_UPLOAD_BYTES=2097152
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Read the client address from X-Real-IP / X-Forwarded-For. Enable this ONLY when a
# proxy you control overwrites those headers, otherwise clients can forge them and
# bypass the login rate limit. The bundled docker-compose sets it because nginx
# fronts the API.
TRUST_PROXY_HEADERS=false
# Seed the demo accounts. Ignored (forced off) when APP_ENV=production, because
# their passwords are published in the README.
SEED_DEMO_USERS=true
